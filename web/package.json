		"@tanstack/react-table": "8.21.3",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"lucide-react": "^1.52.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7",
		"recharts": "3.8.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^30.1.2",
		"shadcn": "^4.21.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}

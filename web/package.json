{
	"name": "@typetorch/web",
	"version": "0.1.0",
	"description": "The TypeTorch backend explorer: overview, Roblox numbers, retention, funnels, players, flow graphs, experiments, fleet, error logs and raw queries. Built into web/dist and served by the backend at /.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "node scripts/vite.mjs dev",
		"build": "tsc -b && vite build",
		"preview": "node scripts/vite.mjs preview",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@fontsource-variable/geist": "^5.3.0",

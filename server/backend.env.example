# /etc/typetorch/backend.env (chmod 640, owner root:typetorch). Never commit the real file.
# Docker and Coolify take these as environment variables (compose.yaml lists them); this file is for the systemd unit.
# Generate each secret with: openssl rand -hex 32

# --- Required: 32+ random characters each, different from each other. The server refuses to start otherwise. -------------
# Game servers write with the API key (events, heartbeats, deploy reports, alerts, error logs). It reads nothing.
TYPETORCH_API_KEY=
# The CLI and the explorer read and manage with the admin token.
TYPETORCH_ADMIN_TOKEN=

# --- Optional ---------------------------------------------------------------------------------------------------------------
# While rotating the API key: put the old one here, update the games, then remove this line.
TYPETORCH_API_KEY_PREVIOUS=
# Where the server keeps its data (a folder; DuckDB files, Parquet days, SQLite). Default ./data, /data in Docker.
TYPETORCH_DATA_DIR=/var/lib/typetorch-backend
# Listen address. Behind Caddy on the same box: 127.0.0.1. In Docker: 0.0.0.0.
HOST=127.0.0.1
PORT=8787
# The public https address (no trailing slash): the Roblox sign-in redirect, Secure cookies, origin checks.
TYPETORCH_PUBLIC_URL=
# Proxies in front (Caddy, Coolify's Traefik = 1): client addresses come from X-Forwarded-For. Leave off when the server
# is reachable without a proxy (the header could be forged).
TYPETORCH_TRUST_PROXY=1
# Only these addresses may reach admin routes, the explorer and the login (others get 404). Game routes stay open to any
# address. Comma-separated addresses and CIDR ranges.
TYPETORCH_ADMIN_ALLOW_IPS=
# off hides and refuses the admin-token login in the browser (the CLI's Bearer token still works).
TYPETORCH_TOKEN_LOGIN=on
# Sign in with Roblox for the game's owners: the OAuth app's client id and secret (scopes openid profile; redirect
# <TYPETORCH_PUBLIC_URL>/v1/auth/roblox/callback). Both set = on.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Right to Erasure: the secret you set on the Roblox webhook, an Open Cloud key with universe-datastores.objects:read on the
# game's universe (UserId -> pid through TypeTorchAnalytics / p/<UserId>), and the universe id.
ROBLOX_WEBHOOK_SECRET=
OPENCLOUD_API_KEY=
TYPETORCH_UNIVERSE_ID=
# Remote debug's instant wake (README "Remote debug"): an Open Cloud key with ONLY universe-messaging-service:publish on
# the game's universe (TYPETORCH_UNIVERSE_ID above). Empty = a watched server starts polling at its next heartbeat.
TYPETORCH_MESSAGING_KEY=
# Alerts to a Discord / Slack / JSON webhook (critical only by default).
TYPETORCH_ALERT_WEBHOOK_URL=

# --- Advanced (defaults suit a 1 GB VPS) -----------------------------------------------------------------------------------
# The explorer's Settings page can change the alert webhook, the allow list, the token login, the rate limits and the
# retention numbers while the server runs (saved in <data dir>/runtime-settings.json; those values win over this file).
# off ignores the saved values and makes the page read only: the way back in after locking yourself out.
# TYPETORCH_RUNTIME_SETTINGS=on
# Which parts run: analytics (DuckDB), fleet (SQLite), or both. A game on Basin runs only "fleet". Error logs are always on.
TYPETORCH_PARTS=analytics,fleet
TYPETORCH_MEMORY_LIMIT=400MB
TYPETORCH_THREADS=1
TYPETORCH_LOAD_SECONDS=5
TYPETORCH_KEEP_DAYS=400
TYPETORCH_RAW_KEEP_DAYS=14
# Read-only ad-hoc SQL for the admin token (POST /v1/sql) in its own sandboxed DuckDB instance; 0 turns it off.
# Its memory comes on top of TYPETORCH_MEMORY_LIMIT: 400 + 256 MB plus the runtime can pass the unit's MemoryHigh
# (800M) on a 1 GB box when a nightly export and an ad-hoc query overlap, so 128MB here (the code default is 256MB).
TYPETORCH_SQL=1
TYPETORCH_SQL_MEMORY=128MB
# 1 = also delete the DataStore link on erasure (the Open Cloud key then needs universe-datastores.objects:delete).
TYPETORCH_ERASURE_DELETE_LINK=0
# Alert webhook: discord, slack or json (detected from the URL), and which levels to send.
# TYPETORCH_ALERT_WEBHOOK_FORMAT=
# TYPETORCH_ALERT_WEBHOOK_LEVELS=critical
# Error logs: days of per-minute counts kept, and the most error kinds stored.
# TYPETORCH_ERROR_KEEP_DAYS=30
# TYPETORCH_ERROR_MAX_KINDS=5000
# Explorer sessions (hours idle, days at most) and failed logins per address before a 429 (count, minutes).
# TYPETORCH_SESSION_IDLE_HOURS=12
# TYPETORCH_SESSION_MAX_DAYS=7
# TYPETORCH_LOGIN_MAX_FAILURES=5
# TYPETORCH_LOGIN_WINDOW_MINUTES=15
# Event bus: messages and bytes a queued subscriber (the live stream, the alert webhook) may hold before it drops.
# TYPETORCH_BUS_MAX_QUEUE=1000
# TYPETORCH_BUS_MAX_BYTES=8388608
# Concurrent GET /v1/live streams.
# TYPETORCH_LIVE_MAX_CLIENTS=20
# Where the built explorer is (default web/dist); TYPETORCH_EXPLORER=off serves the API only.
# TYPETORCH_WEB_DIR=
# TYPETORCH_EXPLORER=on

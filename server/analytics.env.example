# /etc/typetorch/analytics.env (chmod 640, owner root:typetorch). Generate each token with: openssl rand -hex 32
# Never commit the real file.

TT_ANALYTICS_DATA=/var/lib/typetorch-analytics
TT_ANALYTICS_HOST=127.0.0.1
TT_ANALYTICS_PORT=8787
# Behind Caddy on the same box: take the client IP from X-Forwarded-For.
TT_ANALYTICS_TRUST_PROXY=1
# Which parts run: analytics (DuckDB), fleet (SQLite), or both. A game on Basin runs only "fleet".
TT_SERVER_PARTS=analytics,fleet

# Write-only token(s) for game servers and the CLI's posts (comma-separated, for rotation).
TT_ANALYTICS_INGEST_TOKENS=
# Read token for queries, fleet reads and erasure by pid (the CLI's TYPETORCH_FLEET_TOKEN / TT_ANALYTICS_ADMIN_TOKEN).
TT_ANALYTICS_ADMIN_TOKEN=

# DuckDB on a 1 GB VPS
TT_ANALYTICS_MEMORY_LIMIT=400MB
TT_ANALYTICS_THREADS=1
TT_ANALYTICS_LOAD_SECONDS=5
TT_ANALYTICS_KEEP_DAYS=400
TT_ANALYTICS_RAW_KEEP_DAYS=14

# Right to Erasure: the secret you set on the Roblox webhook, and an Open Cloud key with
# universe-datastores.objects:read on the game's universe (for UserId -> pid through TypeTorchAnalytics / p/<UserId>).
TT_ANALYTICS_WEBHOOK_SECRET=
TT_ANALYTICS_OPENCLOUD_KEY=
TT_ANALYTICS_UNIVERSE_ID=
# 1 = also delete the DataStore link (the key then needs universe-datastores.objects:delete).
TT_ANALYTICS_ERASURE_DELETE_LINK=0

# Fleet alerts to a Discord/Slack/JSON webhook (critical only by default).
TT_FLEET_WEBHOOK_URL=
TT_FLEET_WEBHOOK_LEVELS=critical

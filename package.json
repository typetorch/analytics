{
	"name": "@typetorch/backend",
	"version": "0.1.0",
	"description": "The TypeTorch backend: one server for game fleet status, analytics (DuckDB / Basin), error logs, an event bus and the web explorer. Two keys (a game API key and an admin token), Sign in with Roblox for owners, one Docker image for Coolify.",
	"license": "MIT",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/typetorch/backend.git"
	},
	"keywords": [
		"roblox",
		"roblox-ts",
		"typetorch",
		"backend",
		"analytics",
		"fleet",
		"error-logs",
		"duckdb",
		"cloudflare",
		"basin",
		"iceberg"
	],
	"type": "module",
	"bin": {
		"typetorch-backend": "dist/server/main.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"basin",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"server": "bun src/server/main.ts",
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"test": "bun test",
		"test:all": "bun test && cd web && bun run test",
		"typecheck": "tsc --noEmit",
		"basin:schemas": "bun scripts/gen-basin-schemas.ts",
		"loadtest": "bun scripts/loadtest.ts",
		"smoke": "node scripts/smoke.mjs",
		"bench:nightly": "bun scripts/nightly-bench.ts",
		"report": "bun scripts/report.ts",
		"local": "bun scripts/local.ts",
		"web:install": "cd web && bun install --frozen-lockfile",
		"web:build": "cd web && bun run build",
		"web:dev": "cd web && bun run dev"
	},
	"dependencies": {
		"@duckdb/node-api": "^1.5.6-r.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"typescript": "^5.9.0"
	}
}
